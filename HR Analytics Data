import pandas as pd
import random

# Number of employee records
num_records = 1500

# Sample data
departments = ["Human Resources", "Research & Development", "Sales"]
genders = ["Male", "Female"]
attrition = ["Yes", "No"]

data = []

for i in range(1, num_records + 1):

    age = random.randint(18, 60)

    # Age Group Logic
    if age <= 25:
        age_group = "18-25"
    elif age <= 35:
        age_group = "26-35"
    elif age <= 45:
        age_group = "36-45"
    elif age <= 55:
        age_group = "46-55"
    else:
        age_group = "55+"

    employee = {
        "Emp ID": i,
        "Department": random.choice(departments),
        "Gender": random.choice(genders),
        "Age": age,
        "Age Group": age_group,
        "Monthly Income": random.randint(2000, 8000),
        "Attrition": random.choice(attrition)
    }

    data.append(employee)

# Create DataFrame
df = pd.DataFrame(data)

# Save Excel File
df.to_excel(
    r"C:\Users\Dell\OneDrive\Desktop\HR_Analytics_Dashboard_Data.xlsx",
    index=False
)

print("Excel file created successfully!")